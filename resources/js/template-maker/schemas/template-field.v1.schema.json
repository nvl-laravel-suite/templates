{
  "$id": "urn:gct:schema:template-field.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "schema": {
      "$ref": "#/$defs/__schema1"
    },
    "required": {
      "default": true,
      "type": "boolean"
    },
    "editable": {
      "default": true,
      "type": "boolean"
    },
    "sample": {
      "$ref": "#/$defs/__schema3"
    },
    "defaultValue": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "id",
    "path",
    "label",
    "description",
    "schema",
    "required",
    "editable"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^(?!constructor$|prototype$)[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "date",
                "date-time",
                "email",
                "uri"
              ]
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "enum": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number",
                "integer"
              ]
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/__schema1"
            },
            "minItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/__schema0"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "additionalProperties": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "type",
            "properties",
            "additionalProperties"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema3"
          }
        }
      ]
    }
  }
}
