{
    "name": "nvl/templates",
    "description": "Composable Blade and PDF template abstractions and renderers for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "templates",
        "rendering",
        "documents",
        "localization",
        "media"
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nvl/content": "^5.0",
        "nvl/core": "^5.0",
        "nvl/filterable": "^5.0",
        "nvl/media": "^5.0",
        "nvl/translatable": "^5.0",
        "spatie/laravel-data": "^4.23",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "mpdf/mpdf": "^8.3.0",
        "nvl/tenancy": "^5.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Templates\\": "src/",
            "Nvl\\Templates\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Templates\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Templates\\Providers\\TemplatesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "mpdf/mpdf": "Built-in PDF renderer: composer require mpdf/mpdf:^8.3.0 --with-all-dependencies (requires GD and mbstring).",
        "nvl/tenancy": "Enables enforcing tenant ownership, scoped execution, adoption, and captured tenant queue contexts.",
        "spatie/typescript-transformer": "Consume the declared TypeScript attributes and metadata (^3.3); Core retains the runtime transformation engine."
    },
    "conflict": {
        "mpdf/mpdf": "<8.3.0 || >=9.0",
        "nvl/tenancy": "<5.0 || >=6.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/templates",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/templates",
        "docs": "https://github.com/nvl-laravel-suite/templates#readme",
        "issues": "https://github.com/nvl-laravel-suite/templates/issues",
        "security": "https://github.com/nvl-laravel-suite/templates/security/policy"
    }
}
