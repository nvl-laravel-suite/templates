{
  "name": "@nicolasvlachos/voucher-builder",
  "version": "1.0.0",
  "type": "module",
  "description": "Private canonical frontend maintainer workspace for the nvl/templates Composer package.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasvlachos/voucher-builder.git"
  },
  "sideEffects": [
    "**/*.css",
    "./src/voucher-builder/blocks/definitions/**/*.ts",
    "./src/voucher-builder/blocks/traits/**/*.ts",
    "./src/voucher-builder/builder/settings/scopes/**/*.ts",
    "./dist/**/*.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "browser": {
    "postcss": "./dist-browser/postcss.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/types/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./renderer": {
      "types": "./dist/types/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./hooks": {
      "types": "./dist/types/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./schema": {
      "types": "./dist/types/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./manifest": {
      "types": "./dist/types/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./headless": {
      "types": "./dist/types/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./template-creator": {
      "types": "./dist/types/template-creator.d.ts",
      "import": "./dist/template-creator.js"
    },
    "./template-schema": {
      "types": "./dist/types/template-schema.d.ts",
      "import": "./dist/template-schema.js"
    },
    "./template-renderer": {
      "types": "./dist/types/template-renderer.d.ts",
      "import": "./dist/template-renderer.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "dist-browser",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "schemas",
    "INSTALLATION.md",
    "docs/*.md",
    "docs/ui-compliance.*.json",
    "docs/examples",
    "examples",
    "tsconfig.examples.json"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "predev": "npm run build:browser",
    "dev": "vite dev --port 3000",
    "prebuild": "npm run build:browser",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:browser": "node scripts/build-browser.mjs",
    "build:types": "tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "build:package": "npm run build:lib && npm run build:browser && npm run build:types && npm run build:schemas",
    "build:composer": "npm run build:schemas && node scripts/build-composer.mjs",
    "check:composer": "node scripts/build-composer.mjs --check",
    "test:composer": "node --test scripts/build-composer.test.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:worker": "node --test scripts/render-module.test.mjs",
    "prepare": "npm run build:package",
    "build:schemas": "node scripts/build-schemas.mjs",
    "check:schemas": "node scripts/build-schemas.mjs --check",
    "typecheck": "tsc --noEmit",
    "build:docs": "node scripts/build-api-docs.mjs",
    "check:docs": "node scripts/build-api-docs.mjs --check && node scripts/check-docs.mjs",
    "build:examples": "node examples/template-composition.mjs --write",
    "check:examples": "tsc -p tsconfig.examples.json && node examples/template-composition.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:frontend": "node scripts/check-frontend.mjs",
    "verify": "npm run check:frontend && npm run typecheck && npm test && npm run build && npm run build:package && npm run build:composer && npm run test:composer && npm run check:composer && npm run test:worker && npm run check:schemas && npm run check:package && npm run check:browser",
    "setup:ui": "node scripts/setup-themelia.mjs --write",
    "check:ui-skill": "node scripts/setup-themelia.mjs",
    "test:ui-skills": "node --test scripts/setup-themelia.test.mjs scripts/ui-scope.test.mjs scripts/composition-output-exceptions.test.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:ui-audit": "node scripts/audit-ui.mjs",
    "lint": "npm run check:ui"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "themelia-react-ui": "^2.0.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.0.0",
    "nanoid": "^5.1.6",
    "parse5": "^8.0.1",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "qrcode": "^1.5.4",
    "react-day-picker": "10.0.2",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "themelia-react-ui": "2.0.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true
}
